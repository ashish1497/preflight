# Chat assistant (Google Gemini). Add as many as you like: _2, _3, ... tried in order.
GOOGLE_GEMINI_KEY=
GOOGLE_GEMINI_KEY_2=
# Alerts (optional)
RESEND_API_KEY=
RESEND_FROM="ShipCheck <alerts@yourdomain.com>"
TELEGRAM_BOT_TOKEN=
# Database (optional). Without it, data stays in each browser.
# Paste your MongoDB connection string. If it contains <db_password>, put the password here instead:
MONGODB_URI=
MONGODB_PASSWORD=
MONGODB_DB=shipcheck
